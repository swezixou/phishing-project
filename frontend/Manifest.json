{
  "manifest_version": 3,
  "name": "Phishing Detector",
  "version": "1.0.0",
  "description": "Analyse les emails et détecte le phishing via un modèle SVM.",

  "permissions": [
    "activeTab",
    "scripting"
  ],


  "host_permissions": [
    "http://localhost:8000/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },



"content_scripts": [
  {
    "matches": [
      "https://mail.google.com/*",
      "https://outlook.live.com/*",
      "https://outlook.office.com/*",
      "https://mail.yahoo.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }
],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}